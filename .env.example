# ======================
# TeamBase 환경변수 설정
# ======================
# 이 파일을 .env.local로 복사 후 실제 값을 입력하세요.
# cp .env.example .env.local

# ---- 필수 (Required) ----

# PostgreSQL 데이터베이스 URL
DATABASE_URL="postgresql://user:password@localhost:5432/teambase?schema=public"

# NextAuth 시크릿 키 (openssl rand -base64 32 으로 생성)
NEXTAUTH_SECRET="your-secret-key-here"

# NextAuth URL
NEXTAUTH_URL="http://localhost:3000"

# 익명 피드백 솔트 (openssl rand -hex 16 으로 생성)
FEEDBACK_SALT="your-feedback-salt-here"

# ---- SSO (Keycloak) ----
# SSO_URL, SSO_CLIENT_ID, SSO_CLIENT_SECRET 세 가지를 모두 설정하면 SSO 활성화
# 미설정 시 이메일/비밀번호 로그인으로 폴백

# Keycloak 서버 URL
# SSO_URL="https://sso.example.com"

# Keycloak 클라이언트 ID
# SSO_CLIENT_ID="teambase"

# Keycloak 클라이언트 시크릿
# SSO_CLIENT_SECRET="your-client-secret"

# Keycloak Realm (기본값: master)
# SSO_REALM="master"

# ---- 이메일 (Resend) ----
# 알림 이메일 발송용 (미설정 시 이메일 발송 건너뜀)
# RESEND_API_KEY=""

# ---- 선택 (Optional) ----

# Sentry DSN (에러 모니터링)
# SENTRY_DSN=""
# SENTRY_AUTH_TOKEN=""

# 로그 레벨 (debug, info, warn, error)
# LOG_LEVEL="info"

# Node 환경 (development, production, test)
# NODE_ENV="development"
