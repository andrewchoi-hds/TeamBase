generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Authentication & User Models
// ============================================

enum Role {
  ADMIN
  MANAGER
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  role         Role     @default(MEMBER)
  position     String?
  profileImage String?
  departmentId String?
  managerId    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // SSO
  ssoProvider String?
  ssoId       String?  @unique

  department   Department? @relation(fields: [departmentId], references: [id])
  manager      User?       @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates User[]      @relation("ManagerSubordinates")

  accounts Account[]
  sessions Session[]

  reviewAssignmentsAsReviewer ReviewAssignment[] @relation("Reviewer")
  reviewAssignmentsAsTarget   ReviewAssignment[] @relation("ReviewTarget")
  reviewsWritten              Review[]           @relation("ReviewAuthor")
  reviewsReceived             Review[]           @relation("ReviewTarget")
  reviewSummaries             ReviewSummary[]    @relation("SummaryTarget")

  kudosSent        Kudos[]          @relation("KudosSender")
  kudosReceived    Kudos[]          @relation("KudosReceiver")
  notifications    Notification[]
  accessLogsViewer AccessLog[] @relation("AccessLogViewer")
  accessLogsTarget AccessLog[] @relation("AccessLogTarget")
  auditLogs        AuditLog[]
  developmentGoals DevelopmentGoal[] @relation("DevGoalOwner")

  feedbackSessionsCreated      FeedbackSession[]            @relation("FeedbackSessionCreator")
  feedbackSessionTargets       FeedbackSessionTarget[]      @relation("FeedbackSessionTargetUser")
  feedbackSessionParticipants  FeedbackSessionParticipant[] @relation("FeedbackSessionParticipantUser")
  feedbackSessionResponses     FeedbackSessionResponse[]    @relation("FeedbackSessionResponseAuthor")

  @@index([departmentId])
  @@index([managerId])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// Department
// ============================================

model Department {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children Department[] @relation("DepartmentHierarchy")
  users    User[]

  @@index([parentId])
}

// ============================================
// Review System
// ============================================

enum QuestionType {
  RATING
  TEXT
  SINGLE_CHOICE
  MULTI_CHOICE
}

enum ReviewCycleStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

model ReviewCycle {
  id              String            @id @default(cuid())
  name            String
  description     String?
  status          ReviewCycleStatus @default(DRAFT)
  startDate       DateTime
  endDate         DateTime
  templateId      String?
  assignmentRules Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  template    ReviewTemplate?    @relation(fields: [templateId], references: [id])
  assignments ReviewAssignment[]
  reviews     Review[]
  reviewSummaries  ReviewSummary[]
  developmentGoals DevelopmentGoal[]

  @@index([status])
}

model ReviewTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  guideline   String?  @db.Text
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories   ReviewCategory[]
  reviewCycles ReviewCycle[]
}

model ReviewCategory {
  id         String @id @default(cuid())
  templateId String
  name       String
  weight     Float  @default(1.0)
  order      Int    @default(0)

  template ReviewTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  criteria ReviewCriterion[]

  @@index([templateId])
}

model ReviewCriterion {
  id           String       @id @default(cuid())
  categoryId   String
  name         String
  description  String?
  order        Int          @default(0)
  questionType QuestionType @default(RATING)
  options      Json?
  isRequired   Boolean      @default(true)

  category  ReviewCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  responses ReviewResponse[]

  @@index([categoryId])
}

enum ReviewType {
  SELF
  PEER
  UPWARD
  DOWNWARD
}

enum ReviewAssignmentStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  CANCELLED
}

model ReviewAssignment {
  id         String                 @id @default(cuid())
  cycleId    String
  reviewerId String
  targetId   String
  reviewType ReviewType
  status     ReviewAssignmentStatus @default(PENDING)
  dueDate    DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  cycle    ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  reviewer User        @relation("Reviewer", fields: [reviewerId], references: [id])
  target   User        @relation("ReviewTarget", fields: [targetId], references: [id])
  review   Review?

  @@unique([cycleId, reviewerId, targetId])
  @@index([cycleId])
  @@index([reviewerId])
  @@index([targetId])
}

enum ReviewStatus {
  DRAFT
  SUBMITTED
}

model Review {
  id             String       @id @default(cuid())
  assignmentId   String       @unique
  cycleId        String
  authorId       String
  targetId       String
  status         ReviewStatus @default(DRAFT)
  overallRating  Float?
  overallComment String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assignment ReviewAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  cycle      ReviewCycle      @relation(fields: [cycleId], references: [id])
  author     User             @relation("ReviewAuthor", fields: [authorId], references: [id])
  target     User             @relation("ReviewTarget", fields: [targetId], references: [id])
  responses  ReviewResponse[]

  @@index([cycleId])
  @@index([authorId])
  @@index([targetId])
  @@index([createdAt])
  @@index([status])
}

model ReviewResponse {
  id              String  @id @default(cuid())
  reviewId        String
  criterionId     String
  rating          Int?
  comment         String? @db.Text
  textValue       String? @db.Text
  selectedOptions Json?

  review    Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criterion ReviewCriterion @relation(fields: [criterionId], references: [id])

  @@unique([reviewId, criterionId])
  @@index([reviewId])
}

// ============================================
// Feedback Category (shared by session feedback)
// ============================================

enum FeedbackCategory {
  STRENGTH
  IMPROVEMENT
  GENERAL
}

// ============================================
// Notification System
// ============================================

enum NotificationType {
  REVIEW_REQUESTED
  REVIEW_SUBMITTED
  REVIEW_CYCLE_STARTED
  REVIEW_CYCLE_ENDING
  REVIEW_REOPENED
  FEEDBACK_RECEIVED
  ACCESS_LOG_ALERT
  KUDOS_RECEIVED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

// ============================================
// Access Log
// ============================================

enum ResourceType {
  REVIEW
  FEEDBACK
  PROFILE
}

model AccessLog {
  id               String       @id @default(cuid())
  viewerId         String
  targetId         String
  resourceType     ResourceType
  resourceId       String?
  notificationSent Boolean      @default(false)
  createdAt        DateTime     @default(now())

  viewer User @relation("AccessLogViewer", fields: [viewerId], references: [id])
  target User @relation("AccessLogTarget", fields: [targetId], references: [id])

  @@index([viewerId])
  @@index([targetId])
  @@index([createdAt])
}

// ============================================
// Audit Log
// ============================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SUBMIT
  REOPEN
  STATUS_CHANGE
  AUTO_CLOSE
}

enum AuditEntityType {
  REVIEW
  REVIEW_ASSIGNMENT
  REVIEW_CYCLE
  REVIEW_TEMPLATE
  DEVELOPMENT_GOAL
}

model AuditLog {
  id         String          @id @default(cuid())
  action     AuditAction
  entityType AuditEntityType
  entityId   String
  userId     String?
  changes    Json?
  metadata   Json?
  createdAt  DateTime        @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ============================================
// Development Goal System
// ============================================

enum DevelopmentGoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model DevelopmentGoal {
  id            String                @id @default(cuid())
  ownerId       String
  title         String
  description   String?               @db.Text
  status        DevelopmentGoalStatus  @default(ACTIVE)
  sourceType    String                @default("SELF") // REVIEW | FEEDBACK | SELF
  sourceCycleId String?
  targetDate    DateTime?
  completedAt   DateTime?
  progress      Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  owner         User                  @relation("DevGoalOwner", fields: [ownerId], references: [id])
  sourceCycle   ReviewCycle?          @relation(fields: [sourceCycleId], references: [id])
  feedbackLinks DevelopmentGoalFeedback[]

  @@index([ownerId])
  @@index([status])
  @@index([sourceCycleId])
}

model DevelopmentGoalFeedback {
  id                String   @id @default(cuid())
  developmentGoalId String
  sessionResponseId String?
  createdAt         DateTime @default(now())

  developmentGoal DevelopmentGoal          @relation(fields: [developmentGoalId], references: [id], onDelete: Cascade)
  sessionResponse FeedbackSessionResponse? @relation(fields: [sessionResponseId], references: [id], onDelete: SetNull)

  @@unique([developmentGoalId, sessionResponseId])
  @@index([developmentGoalId])
}

// ============================================
// Feedback Session System
// ============================================

enum FeedbackSessionMode {
  NAMED
  ANONYMOUS
}

enum FeedbackSessionStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model FeedbackSession {
  id                       String                @id @default(cuid())
  name                     String
  description              String?               @db.Text
  mode                     FeedbackSessionMode   @default(NAMED)
  status                   FeedbackSessionStatus @default(DRAFT)
  createdById              String
  startDate                DateTime?
  endDate                  DateTime?
  minResponsesForVisibility Int                  @default(3)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  createdBy User                    @relation("FeedbackSessionCreator", fields: [createdById], references: [id])
  targets   FeedbackSessionTarget[]

  @@index([status])
  @@index([createdById])
}

model FeedbackSessionTarget {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  createdAt DateTime @default(now())

  session      FeedbackSession              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User                         @relation("FeedbackSessionTargetUser", fields: [userId], references: [id])
  participants FeedbackSessionParticipant[]
  responses    FeedbackSessionResponse[]

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

model FeedbackSessionParticipant {
  id       String   @id @default(cuid())
  targetId String
  userId   String
  createdAt DateTime @default(now())

  target FeedbackSessionTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  user   User                  @relation("FeedbackSessionParticipantUser", fields: [userId], references: [id])

  @@unique([targetId, userId])
  @@index([targetId])
  @@index([userId])
}

model FeedbackSessionResponse {
  id        String           @id @default(cuid())
  targetId  String
  authorId  String?
  category  FeedbackCategory @default(GENERAL)
  content   String           @db.Text
  createdAt DateTime         @default(now())

  target FeedbackSessionTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  author User?                 @relation("FeedbackSessionResponseAuthor", fields: [authorId], references: [id])
  developmentGoalLinks DevelopmentGoalFeedback[]

  @@index([targetId])
  @@index([authorId])
}

// ============================================
// AI Review Summary (cache)
// ============================================

model ReviewSummary {
  id        String   @id @default(cuid())
  cycleId   String
  targetId  String
  content   String   @db.Text // JSON: { strengths, improvements, overall }
  createdAt DateTime @default(now())

  cycle  ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  target User        @relation("SummaryTarget", fields: [targetId], references: [id])

  @@unique([cycleId, targetId])
  @@index([targetId])
}

// ============================================
// Kudos (Peer Recognition)
// ============================================

model Kudos {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  message    String   @db.Text
  tags       Json?
  createdAt  DateTime @default(now())

  sender   User @relation("KudosSender", fields: [senderId], references: [id])
  receiver User @relation("KudosReceiver", fields: [receiverId], references: [id])

  @@index([receiverId])
  @@index([createdAt])
}
