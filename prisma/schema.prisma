generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Authentication & User Models
// ============================================

enum Role {
  ADMIN
  MANAGER
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(MEMBER)
  position     String?
  profileImage String?
  departmentId String?
  managerId    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department   Department? @relation(fields: [departmentId], references: [id])
  manager      User?       @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates User[]      @relation("ManagerSubordinates")

  accounts Account[]
  sessions Session[]

  reviewAssignmentsAsReviewer ReviewAssignment[] @relation("Reviewer")
  reviewAssignmentsAsTarget   ReviewAssignment[] @relation("ReviewTarget")
  reviewsWritten              Review[]           @relation("ReviewAuthor")
  reviewsReceived             Review[]           @relation("ReviewTarget")

  identifiedFeedbackGiven    IdentifiedFeedback[] @relation("FeedbackAuthor")
  identifiedFeedbackReceived IdentifiedFeedback[] @relation("FeedbackTarget")
  anonymousFeedbackReceived  AnonymousFeedback[]  @relation("AnonymousFeedbackTarget")

  objectives Objective[]

  meetingsAsOrganizer   Meeting[] @relation("MeetingOrganizer")
  meetingsAsParticipant Meeting[] @relation("MeetingParticipant")
  meetingNotes          MeetingNote[]
  actionItems           ActionItem[]

  notifications    Notification[]
  accessLogsViewer AccessLog[] @relation("AccessLogViewer")
  accessLogsTarget AccessLog[] @relation("AccessLogTarget")

  @@index([departmentId])
  @@index([managerId])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// Department
// ============================================

model Department {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children Department[] @relation("DepartmentHierarchy")
  users    User[]

  @@index([parentId])
}

// ============================================
// Review System
// ============================================

enum ReviewCycleStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

model ReviewCycle {
  id          String            @id @default(cuid())
  name        String
  description String?
  status      ReviewCycleStatus @default(DRAFT)
  startDate   DateTime
  endDate     DateTime
  templateId  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  template    ReviewTemplate?    @relation(fields: [templateId], references: [id])
  assignments ReviewAssignment[]
  reviews     Review[]

  @@index([status])
}

model ReviewTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories   ReviewCategory[]
  reviewCycles ReviewCycle[]
}

model ReviewCategory {
  id         String @id @default(cuid())
  templateId String
  name       String
  weight     Float  @default(1.0)
  order      Int    @default(0)

  template ReviewTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  criteria ReviewCriterion[]

  @@index([templateId])
}

model ReviewCriterion {
  id          String  @id @default(cuid())
  categoryId  String
  name        String
  description String?
  order       Int     @default(0)

  category  ReviewCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  responses ReviewResponse[]

  @@index([categoryId])
}

enum ReviewType {
  SELF
  PEER
  UPWARD
  DOWNWARD
}

enum ReviewAssignmentStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  CANCELLED
}

model ReviewAssignment {
  id         String                 @id @default(cuid())
  cycleId    String
  reviewerId String
  targetId   String
  reviewType ReviewType
  status     ReviewAssignmentStatus @default(PENDING)
  dueDate    DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  cycle    ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  reviewer User        @relation("Reviewer", fields: [reviewerId], references: [id])
  target   User        @relation("ReviewTarget", fields: [targetId], references: [id])
  review   Review?

  @@unique([cycleId, reviewerId, targetId])
  @@index([cycleId])
  @@index([reviewerId])
  @@index([targetId])
}

enum ReviewStatus {
  DRAFT
  SUBMITTED
}

model Review {
  id             String       @id @default(cuid())
  assignmentId   String       @unique
  cycleId        String
  authorId       String
  targetId       String
  status         ReviewStatus @default(DRAFT)
  overallRating  Float?
  overallComment String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assignment ReviewAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  cycle      ReviewCycle      @relation(fields: [cycleId], references: [id])
  author     User             @relation("ReviewAuthor", fields: [authorId], references: [id])
  target     User             @relation("ReviewTarget", fields: [targetId], references: [id])
  responses  ReviewResponse[]

  @@index([cycleId])
  @@index([authorId])
  @@index([targetId])
  @@index([createdAt])
  @@index([status])
}

model ReviewResponse {
  id          String  @id @default(cuid())
  reviewId    String
  criterionId String
  rating      Int
  comment     String? @db.Text

  review    Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criterion ReviewCriterion @relation(fields: [criterionId], references: [id])

  @@unique([reviewId, criterionId])
  @@index([reviewId])
}

// ============================================
// Feedback System
// ============================================

enum FeedbackCategory {
  STRENGTH
  IMPROVEMENT
  GENERAL
}

model IdentifiedFeedback {
  id        String           @id @default(cuid())
  authorId  String
  targetId  String
  category  FeedbackCategory @default(GENERAL)
  content   String           @db.Text
  isPublic  Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  author User @relation("FeedbackAuthor", fields: [authorId], references: [id])
  target User @relation("FeedbackTarget", fields: [targetId], references: [id])

  @@index([authorId])
  @@index([targetId])
}

model AnonymousFeedback {
  id              String           @id @default(cuid())
  targetId        String
  category        FeedbackCategory @default(GENERAL)
  content         String           @db.Text
  submissionToken String           @unique
  createdAt       DateTime         @default(now())

  target User @relation("AnonymousFeedbackTarget", fields: [targetId], references: [id])

  @@index([targetId])
}

model AnonymousFeedbackToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  targetId  String
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tokenHash])
  @@index([targetId])
}

// ============================================
// OKR System
// ============================================

enum ObjectiveStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ObjectiveLevel {
  COMPANY
  TEAM
  INDIVIDUAL
}

model Objective {
  id          String          @id @default(cuid())
  title       String
  description String?         @db.Text
  ownerId     String
  level       ObjectiveLevel  @default(INDIVIDUAL)
  status      ObjectiveStatus @default(DRAFT)
  parentId    String?
  startDate   DateTime
  endDate     DateTime
  progress    Float           @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner      User         @relation(fields: [ownerId], references: [id])
  parent     Objective?   @relation("ObjectiveHierarchy", fields: [parentId], references: [id])
  children   Objective[]  @relation("ObjectiveHierarchy")
  keyResults KeyResult[]

  @@index([ownerId])
  @@index([parentId])
  @@index([status])
}

enum KeyResultType {
  NUMERIC
  PERCENTAGE
  CURRENCY
  BOOLEAN
}

model KeyResult {
  id           String        @id @default(cuid())
  objectiveId  String
  title        String
  type         KeyResultType @default(NUMERIC)
  startValue   Float         @default(0)
  currentValue Float         @default(0)
  targetValue  Float
  unit         String?
  progress     Float         @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  objective Objective        @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  checkIns  KeyResultCheckIn[]

  @@index([objectiveId])
}

model KeyResultCheckIn {
  id          String   @id @default(cuid())
  keyResultId String
  value       Float
  note        String?  @db.Text
  createdAt   DateTime @default(now())

  keyResult KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)

  @@index([keyResultId])
}

// ============================================
// Meeting System
// ============================================

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Meeting {
  id            String        @id @default(cuid())
  title         String
  organizerId   String
  participantId String
  scheduledAt   DateTime
  duration      Int           @default(30)
  status        MeetingStatus @default(SCHEDULED)
  agenda        String?       @db.Text
  recurringId   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  organizer   User              @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  participant User              @relation("MeetingParticipant", fields: [participantId], references: [id])
  recurring   RecurringMeeting? @relation(fields: [recurringId], references: [id])
  notes       MeetingNote[]
  actionItems ActionItem[]

  @@index([organizerId])
  @@index([participantId])
  @@index([scheduledAt])
}

model MeetingNote {
  id        String   @id @default(cuid())
  meetingId String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([meetingId])
}

enum ActionItemStatus {
  TODO
  IN_PROGRESS
  DONE
}

model ActionItem {
  id         String           @id @default(cuid())
  meetingId  String
  assigneeId String
  title      String
  status     ActionItemStatus @default(TODO)
  dueDate    DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  meeting  Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignee User    @relation(fields: [assigneeId], references: [id])

  @@index([meetingId])
  @@index([assigneeId])
}

enum RecurringFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model RecurringMeeting {
  id            String             @id @default(cuid())
  title         String
  organizerId   String
  participantId String
  frequency     RecurringFrequency
  dayOfWeek     Int?
  time          String
  duration      Int                @default(30)
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  meetings Meeting[]
}

// ============================================
// Notification System
// ============================================

enum NotificationType {
  REVIEW_REQUESTED
  REVIEW_SUBMITTED
  REVIEW_CYCLE_STARTED
  REVIEW_CYCLE_ENDING
  FEEDBACK_RECEIVED
  MEETING_SCHEDULED
  MEETING_REMINDER
  OKR_CHECK_IN_DUE
  ACCESS_LOG_ALERT
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

// ============================================
// Access Log
// ============================================

enum ResourceType {
  REVIEW
  FEEDBACK
  OKR
  PROFILE
  MEETING
}

model AccessLog {
  id               String       @id @default(cuid())
  viewerId         String
  targetId         String
  resourceType     ResourceType
  resourceId       String?
  notificationSent Boolean      @default(false)
  createdAt        DateTime     @default(now())

  viewer User @relation("AccessLogViewer", fields: [viewerId], references: [id])
  target User @relation("AccessLogTarget", fields: [targetId], references: [id])

  @@index([viewerId])
  @@index([targetId])
  @@index([createdAt])
}
